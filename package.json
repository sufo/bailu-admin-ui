{
  "name": "bailu-admin",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "sufo",
    "email": "ouamour@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && cross-env VITE_ENV_TYPE=prod vite build",
    "build:nocheck": "cross-env VITE_ENV_TYPE=prod vite build",
    "build:dev": "npm run typecheck && cross-env VITE_ENV_TYPE=dev vite build",
    "build:test": "npm run typecheck && cross-env VITE_ENV_TYPE=test vite build",
    "build:vercel": "cross-env VITE_HASH_ROUTE=true vite build",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "prepare": "husky install",
    "postinstall": "patch-package",
    "release": "standard-version",
    "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean:lib": "rimraf node_modules",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md"
  },
  "dependencies": {
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/mouse-wheel": "^2.5.1",
    "@iconify-json/carbon": "^1.2.15",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@vicons/ionicons5": "^0.13.0",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^10.11.1",
    "axios": "^1.13.2",
    "colord": "^2.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^5.6.0",
    "jsencrypt": "^3.5.4",
    "lodash-es": "^4.17.21",
    "lunar-typescript": "^1.8.6",
    "pinia": "^3.0.4",
    "qs": "^6.14.0",
    "quill-blot-formatter": "^1.0.5",
    "quill-image-uploader": "^1.3.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.25",
    "vue-country-code": "^1.1.3",
    "vue-cropper": "^1.1.4",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3",
    "vue-tel-input": "^9.5.1",
    "vue-tsc": "^3.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@iconify/vue": "^4.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.2",
    "@types/qs": "^6.14.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vue-macros/volar": "^3.1.2",
    "cross-env": "^7.0.3",
    "default-passive-events": "^4.0.0",
    "husky": "^8.0.3",
    "naive-ui": "^2.43.2",
    "patch-package": "^8.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.95.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^7.2.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-svg-loader": "^5.1.0"
  },
  "//": "Used to install imagemin dependencies, because imagemin may not be installed in China. If it is abroad, you can delete it",
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china"
  },
  "////": "忽略peerDependency警告",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "rollup"
      ]
    }
  }
}