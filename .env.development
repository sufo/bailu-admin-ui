# Whether to open mock
VITE_USE_MOCK = true

# Delete console
VITE_DROP_CONSOLE = false

# proxy 
VITE_PROXY = [["/basic-api","http://localhost:8081"],["/upload","http://localhost:8081/upload"]]
# VITE_PROXY = [["/basic-api","http://10.0.0.102:8081"],["/upload","http://localhost:8081/upload"]]

# public path 网站前缀
VITE_PUBLIC_PATH = /

# Basic interface address SPA
VITE_API_URL=/basic-api

# 上传地址
VITE_UPLOAD_URL= 

# Interface prefix
VITE_API_URL_PREFIX=/api